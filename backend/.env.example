PORT=8787
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_MODE=gemini
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-2.5-flash
PF_PROMPT_KNOWLEDGE_URL=https://raw.githubusercontent.com/khaldonshhab/PromptForgeAI/main/backend/prompt-engine.json
PF_PROMPT_KNOWLEDGE_REFRESH_MS=600000
# Use separate values for each environment; never copy production secrets into test.
PF_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PF_ADMIN_USER=admin
# Set the admin password hash only when configuring an admin account.
PF_ADMIN_PASSWORD_HASH=
# Optional remote database settings; leave blank for an isolated local test.
PF_DB_URL=
PF_DB_KEY=
